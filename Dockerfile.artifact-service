# syntax=docker/dockerfile:1
# Artifact Service — user-scoped artifact catalog (save/list/delete).
# Build context: c:/repos/daemon
#   az acr build -r daemonairlock -t artifact-service:0.1.0 -f Dockerfile.artifact-service .

FROM node:24-bookworm-slim AS build
WORKDIR /src
COPY daemon/artifact-service/package*.json ./
RUN npm ci
COPY daemon/artifact-service/tsconfig.json ./
COPY daemon/artifact-service/src ./src
RUN npx tsc

FROM node:24-bookworm-slim
WORKDIR /app
COPY --from=build /src/dist ./dist
COPY --from=build /src/node_modules ./node_modules
# Baked-in closed allowlist for /refresh-sync (same series-map as http_proxy data/)
COPY daemon/artifact-service/data/series-map.json ./data/series-map.json
ENV PORT=8793 ARTIFACT_DB_PATH=/data/artifacts.db ARTIFACT_FILES_DIR=/data/files
# REFRESH_DAEMON_URL / DAEMON_HMAC_KEY set via ACA secret/env for /refresh-sync
EXPOSE 8793
CMD ["node", "dist/server.js"]
